			local h, s, v = CPS.Color:ToHSV()
			local hex     = string.format("#%02X%02X%02X", CPS.Color.R * 0xFF, CPS.Color.G * 0xFF, CPS.Color.B * 0xFF)
			ColorPicker.HexInput.InputBox.Text = hex

			local function setDisplay()
				CPMain.MainPoint.Position    = UDim2.new(s, -CPMain.MainPoint.AbsoluteSize.X / 2, 1 - v, -CPMain.MainPoint.AbsoluteSize.Y / 2)
				CPMain.MainPoint.ImageColor3  = Color3.fromHSV(h, s, v)
				Background.BackgroundColor3   = Color3.fromHSV(h, 1, 1)
				Display.BackgroundColor3      = Color3.fromHSV(h, s, v)
				local x = h * Slider.AbsoluteSize.X
				Slider.SliderPoint.Position    = UDim2.new(0, x - Slider.SliderPoint.AbsoluteSize.X / 2, 0.5, 0)
				Slider.SliderPoint.ImageColor3 = Color3.fromHSV(h, 1, 1)
				local c = Color3.fromHSV(h, s, v)
				ColorPicker.RGB.RInput.InputBox.Text = tostring(math.floor(c.R * 255 + 0.5))
				ColorPicker.RGB.GInput.InputBox.Text = tostring(math.floor(c.G * 255 + 0.5))
				ColorPicker.RGB.BInput.InputBox.Text = tostring(math.floor(c.B * 255 + 0.5))
				hex = string.format("#%02X%02X%02X", c.R * 0xFF, c.G * 0xFF, c.B * 0xFF)
				ColorPicker.HexInput.InputBox.Text = hex
			end
			setDisplay()

			ColorPicker.HexInput.InputBox.FocusLost:Connect(function()
				if not pcall(function()
					local r, g, b = ColorPicker.HexInput.InputBox.Text:match("^#?(%w%w)(%w%w)(%w%w)$")
					local rgb = Color3.fromRGB(tonumber(r, 16), tonumber(g, 16), tonumber(b, 16))
					h, s, v = rgb:ToHSV(); hex = ColorPicker.HexInput.InputBox.Text; setDisplay()
					CPS.Color = rgb
				end) then
					ColorPicker.HexInput.InputBox.Text = hex
				end
				pcall(CPS.Callback, Color3.fromHSV(h, s, v))
				CPS.Color = Color3.fromHSV(h, s, v)
				if not CPS.Ext then SaveConfiguration() end
			end)

			local function rgbBox(box, channel)
				local val = tonumber(box.Text)
				local c   = Color3.fromHSV(h, s, v)
				local r0  = math.floor(c.R * 255 + 0.5)
				local g0  = math.floor(c.G * 255 + 0.5)
				local b0  = math.floor(c.B * 255 + 0.5)
				local saved
				if     channel == "R" then saved = r0; r0 = val or saved
				elseif channel == "G" then saved = g0; g0 = val or saved
				else                       saved = b0; b0 = val or saved end
				if val then
					val = math.clamp(val, 0, 255)
					h, s, v = Color3.fromRGB(r0, g0, b0):ToHSV(); setDisplay()
				else
					box.Text = tostring(saved)
				end
				CPS.Color = Color3.fromHSV(h, s, v)
				if not CPS.Ext then SaveConfiguration() end
			end
			ColorPicker.RGB.RInput.InputBox.FocusLost:Connect(function() rgbBox(ColorPicker.RGB.RInput.InputBox, "R"); pcall(CPS.Callback, Color3.fromHSV(h, s, v)) end)
