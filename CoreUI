-- ─── Public API ───────────────────────────────────────────────────────────────
function RayfieldLibrary:SetVisibility(v: boolean)
	if Debounce then return end
	if v then Hidden = false; Unhide() else Hidden = true; Hide(false) end
end

function RayfieldLibrary:IsVisible(): boolean
	return not Hidden
end

function RayfieldLibrary:Destroy()
	rayfieldDestroyed = true
	-- Disconnect draggable handles (MEM-4)
	for _, fn in _draggableCleanups do fn() end
	-- Disconnect all tracked connections (MEM-2)
	disconnectAll(_allConnections)
	Rayfield:Destroy()
end

-- ─── LoadConfiguration (delayed, with config-saving notice) ──────────────────
function RayfieldLibrary:LoadConfiguration()
	local config
	if useStudio then
		config = [[{"Toggle1adwawd":true,"ColorPicker1awd":{"B":255,"G":255,"R":255},"Slider1dawd":100}]]
	end

	if CEnabled then
		local notified = false
		local loaded   = false
		local ok, err  = pcall(function()
			if useStudio and config then
				loaded = LoadConfiguration(config); return
			end
			if isfile then
				local path = ConfigurationFolder .. "/" .. CFileName .. ConfigurationExtension
				if pcallLog(isfile, path) then
					loaded = LoadConfiguration(pcallLog(readfile, path))
				end
			else
				notified = true
				RayfieldLibrary:Notify({ Title = "Rayfield Configurations",
					Content = "Configuration saving unavailable — no filesystem support.",
					Image = 4384402990 })
			end
		end)

		if ok and loaded and not notified then
			RayfieldLibrary:Notify({ Title = "Rayfield Configurations",
				Content = "Configuration loaded from previous session.", Image = 4384403532 })
		elseif not ok and not notified then
			log.warn("Rayfield Configurations Error | " .. tostring(err))
			RayfieldLibrary:Notify({ Title = "Rayfield Configurations",
				Content = "Issue loading configuration. Check Developer Console.", Image = 4384402990 })
		end
	end
	globalLoaded = true
end

