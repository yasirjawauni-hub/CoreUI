			Slider.MouseButton1Down:Connect(function()           sliderDragging = true end)
			Slider.SliderPoint.MouseButton1Down:Connect(function() sliderDragging = true end)

			table.insert(_cpConns, trackConn(RunService.RenderStepped:Connect(function()
				if mainDragging then
					local lx = math.clamp(mouse.X - CPMain.AbsolutePosition.X, 0, CPMain.AbsoluteSize.X)
					local ly = math.clamp(mouse.Y - CPMain.AbsolutePosition.Y, 0, CPMain.AbsoluteSize.Y)
					CPMain.MainPoint.Position    = UDim2.new(0, lx - CPMain.MainPoint.AbsoluteSize.X / 2, 0, ly - CPMain.MainPoint.AbsoluteSize.Y / 2)
					s = lx / CPMain.AbsoluteSize.X
					v = 1 - (ly / CPMain.AbsoluteSize.Y)
					Display.BackgroundColor3    = Color3.fromHSV(h, s, v)
					CPMain.MainPoint.ImageColor3 = Color3.fromHSV(h, s, v)
					Background.BackgroundColor3  = Color3.fromHSV(h, 1, 1)
					local c = Color3.fromHSV(h, s, v)
					ColorPicker.RGB.RInput.InputBox.Text = tostring(math.floor(c.R * 255 + 0.5))
					ColorPicker.RGB.GInput.InputBox.Text = tostring(math.floor(c.G * 255 + 0.5))
					ColorPicker.RGB.BInput.InputBox.Text = tostring(math.floor(c.B * 255 + 0.5))
					ColorPicker.HexInput.InputBox.Text   = string.format("#%02X%02X%02X", c.R * 0xFF, c.G * 0xFF, c.B * 0xFF)
					pcall(CPS.Callback, c); CPS.Color = c
					if not CPS.Ext then SaveConfiguration() end
				end
				if sliderDragging then
					local lx = math.clamp(mouse.X - Slider.AbsolutePosition.X, 0, Slider.AbsoluteSize.X)
					h = lx / Slider.AbsoluteSize.X
					Display.BackgroundColor3     = Color3.fromHSV(h, s, v)
					Slider.SliderPoint.Position   = UDim2.new(0, lx - Slider.SliderPoint.AbsoluteSize.X / 2, 0.5, 0)
					Slider.SliderPoint.ImageColor3 = Color3.fromHSV(h, 1, 1)
					Background.BackgroundColor3   = Color3.fromHSV(h, 1, 1)
					CPMain.MainPoint.ImageColor3   = Color3.fromHSV(h, s, v)
					local c = Color3.fromHSV(h, s, v)
					ColorPicker.RGB.RInput.InputBox.Text = tostring(math.floor(c.R * 255 + 0.5))
					ColorPicker.RGB.GInput.InputBox.Text = tostring(math.floor(c.G * 255 + 0.5))
					ColorPicker.RGB.BInput.InputBox.Text = tostring(math.floor(c.B * 255 + 0.5))
					ColorPicker.HexInput.InputBox.Text   = string.format("#%02X%02X%02X", c.R * 0xFF, c.G * 0xFF, c.B * 0xFF)
					pcall(CPS.Callback, c); CPS.Color = c
					if not CPS.Ext then SaveConfiguration() end
				end
			end)))

			table.insert(_cpConns, trackConn(
				Rayfield.Main:GetPropertyChangedSignal("BackgroundColor3"):Connect(refreshInputColors)
			))

			-- Unified cleanup hook (MEM-3)
			ColorPicker.Destroying:Connect(function() disconnectAll(_cpConns) end)

			ColorPicker.MouseEnter:Connect(function()
				TweenService:Create(ColorPicker, TweenInfo.new(0.6, Enum.EasingStyle.Exponential), { BackgroundColor3 = SelectedTheme.ElementBackgroundHover }):Play()
			end)
			ColorPicker.MouseLeave:Connect(function()
				TweenService:Create(ColorPicker, TweenInfo.new(0.6, Enum.EasingStyle.Exponential), { BackgroundColor3 = SelectedTheme.ElementBackground }):Play()
			end)

			function CPS:Set(color)
				CPS.Color = color; h, s, v = color:ToHSV(); setDisplay()
			end
			function CPS:Destroy() disconnectAll(_cpConns); ColorPicker:Destroy() end

			if Settings.ConfigurationSaving and Settings.ConfigurationSaving.Enabled and CPS.Flag then
				RayfieldLibrary.Flags[CPS.Flag] = CPS
			end
			return CPS
		end

