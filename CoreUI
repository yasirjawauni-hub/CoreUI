-- ─── Notify ───────────────────────────────────────────────────────────────────
function RayfieldLibrary:Notify(data)
	task.spawn(function()
		local n = Notifications.Template:Clone()
		n.Name        = data.Title or "No Title Provided"
		n.Parent      = Notifications
		n.LayoutOrder = #Notifications:GetChildren()
		n.Visible     = false

		n.Title.Text       = data.Title   or "Unknown Title"
		n.Description.Text = data.Content or "Unknown Content"

		if data.Image then
			local img, ro, rs = resolveIcon(data.Image)
			n.Icon.Image = img
			if ro then n.Icon.ImageRectOffset = ro end
			if rs then n.Icon.ImageRectSize   = rs end
		else
			n.Icon.Image = ""
		end

		n.Title.TextColor3         = SelectedTheme.TextColor
		n.Description.TextColor3   = SelectedTheme.TextColor
		n.BackgroundColor3         = SelectedTheme.Background
		n.UIStroke.Color           = SelectedTheme.TextColor
		n.Icon.ImageColor3         = SelectedTheme.TextColor
		n.BackgroundTransparency        = 1
		n.Title.TextTransparency        = 1
		n.Description.TextTransparency  = 1
		n.UIStroke.Transparency         = 1
		n.Shadow.ImageTransparency      = 1
		n.Size                          = UDim2.new(1, 0, 0, 800)
		n.Icon.ImageTransparency        = 1
		n.Icon.BackgroundTransparency   = 1

		task.wait()
		n.Visible = true

		local bounds = { n.Title.TextBounds.Y, n.Description.TextBounds.Y }
		n.Size           = UDim2.new(1, -60, 0, -Notifications:FindFirstChild("UIListLayout").Padding.Offset)
		n.Icon.Size     = UDim2.new(0, 32, 0, 32)
		n.Icon.Position = UDim2.new(0, 20, 0.5, 0)

		TweenService:Create(n, TweenInfo.new(0.6, Enum.EasingStyle.Exponential),
			{ Size = UDim2.new(1, 0, 0, math.max(bounds[1] + bounds[2] + 31, 60)) }):Play()
		task.wait(0.15)
		TweenService:Create(n,              TweenInfo.new(0.4, Enum.EasingStyle.Exponential), { BackgroundTransparency = 0.45 }):Play()
		TweenService:Create(n.Title,        TweenInfo.new(0.3, Enum.EasingStyle.Exponential), { TextTransparency = 0 }):Play()
		task.wait(0.05)
		TweenService:Create(n.Icon,         TweenInfo.new(0.3, Enum.EasingStyle.Exponential), { ImageTransparency = 0 }):Play()
		task.wait(0.05)
		TweenService:Create(n.Description,  TweenInfo.new(0.3, Enum.EasingStyle.Exponential), { TextTransparency = 0.35 }):Play()
		TweenService:Create(n.UIStroke,     TweenInfo.new(0.4, Enum.EasingStyle.Exponential), { Transparency = 0.95 }):Play()
		TweenService:Create(n.Shadow,       TweenInfo.new(0.3, Enum.EasingStyle.Exponential), { ImageTransparency = 0.82 }):Play()

		local waitDur = math.clamp((#n.Description.Text * 0.1) + 2.5, 3, 10)
		task.wait(data.Duration or waitDur)

		n.Icon.Visible = false
		TweenService:Create(n,             TweenInfo.new(0.4, Enum.EasingStyle.Exponential), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(n.UIStroke,    TweenInfo.new(0.4, Enum.EasingStyle.Exponential), { Transparency = 1 }):Play()
		TweenService:Create(n.Shadow,      TweenInfo.new(0.3, Enum.EasingStyle.Exponential), { ImageTransparency = 1 }):Play()
		TweenService:Create(n.Title,       TweenInfo.new(0.3, Enum.EasingStyle.Exponential), { TextTransparency = 1 }):Play()
		TweenService:Create(n.Description, TweenInfo.new(0.3, Enum.EasingStyle.Exponential), { TextTransparency = 1 }):Play()
		TweenService:Create(n,             TweenInfo.new(1,   Enum.EasingStyle.Exponential),
			{ Size = UDim2.new(1, -90, 0, 0) }):Play()
		task.wait(1)
		TweenService:Create(n, TweenInfo.new(1, Enum.EasingStyle.Exponential),
			{ Size = UDim2.new(1, -90, 0, -Notifications:FindFirstChild("UIListLayout").Padding.Offset) }):Play()
		n.Visible = false
		n:Destroy()
	end)
end

