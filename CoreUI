			-- Per-element connections (MEM-1 / MEM-3)
			local _cpConns = {}

			table.insert(_cpConns, trackConn(UserInputService.InputEnded:Connect(function(inp)
				if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
