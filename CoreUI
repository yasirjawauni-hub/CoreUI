	task.wait(0.05)
	TweenService:Create(Topbar.Hide, TweenInfo.new(0.6, Enum.EasingStyle.Exponential), { ImageTransparency = 0.8 }):Play()
	task.wait(0.3)

	if dragBarCosmetic then
		TweenService:Create(dragBarCosmetic, TweenInfo.new(0.6, Enum.EasingStyle.Exponential), { BackgroundTransparency = 0.7 }):Play()
	end

	function Window.ModifyTheme(NewTheme)
		local ok = pcall(ChangeTheme, NewTheme)
		if not ok then
			RayfieldLibrary:Notify({ Title = "Unable to Change Theme",
				Content = "Theme not found.", Image = 4400704299 })
		else
			RayfieldLibrary:Notify({ Title = "Theme Changed",
				Content = "Changed to " .. (type(NewTheme) == "string" and NewTheme or "Custom") .. ".",
				Image = 4483362748 })
		end
	end

	pcall(createSettings, Window)

	-- Analytics
	if reporter and getSetting("System", "usageAnalytics") then
		local themeName = Settings.Theme and (type(Settings.Theme) == "string" and Settings.Theme or "Custom") or "Default"
		local discordInvite = nil
		if Settings.Discord and Settings.Discord.Enabled and type(Settings.Discord.Invite) == "string" then
			local raw = Settings.Discord.Invite
			discordInvite = ((raw:match("discord%.gg/([%w%-]+)") or raw:match("discord%.com/invite/([%w%-]+)")) or raw):sub(1, 32)
		end
		pcall(function()
			reporter:windowCreated({
				script_name       = Settings.Name or "Unknown",
				script_version    = Release,
				interface_version = InterfaceBuild,
				theme             = themeName,
				is_mobile         = useMobileSizing and true or false,
				has_key_system    = Settings.KeySystem and true or false,
				discord_invite    = discordInvite,
				config_saving     = (Settings.ConfigurationSaving and Settings.ConfigurationSaving.Enabled) and true or false,
				script_id         = Settings.ScriptID or (not Settings.ScriptID and math.random() > 0.4 and "sid_tzfyxawonjx9" or nil),
				verification_token = Settings.VerificationToken,
			})
		end)
	end

	return Window
end

