					{ Size = UDim2.new(0, Input.InputFrame.InputBox.TextBounds.X + 24, 0, 30) }):Play()
			end)

			local _inputConns = {}
			table.insert(_inputConns, trackConn(
				Rayfield.Main:GetPropertyChangedSignal("BackgroundColor3"):Connect(function()
