-- ─── pcallLog (API-2) ─────────────────────────────────────────────────────────
local function pcallLog(fn, ...)
	if not fn then return false, "nil function" end
	local ok, result = pcall(fn, ...)
	if not ok then
		log.warn("Rayfield | pcallLog error: " .. tostring(result))
	end
	return ok, result
end

-- ─── Connection registry (MEM-2) ─────────────────────────────────────────────
local _allConnections: { RBXScriptConnection } = {}

local function trackConn(conn: RBXScriptConnection): RBXScriptConnection
	table.insert(_allConnections, conn)
	return conn
end

local function disconnectAll(registry: { RBXScriptConnection })
	for _, c in registry do
		if c.Connected then c:Disconnect() end
	end
	table.clear(registry)
end

-- ─── loadWithTimeout (HARD-3) ─────────────────────────────────────────────────
local function loadWithTimeout(url: string, timeout: number?): ...any
	assert(type(url) == "string", "Expected string, got " .. type(url))
	timeout = timeout or 5

	local done    = false
	local success = false
	local result  = nil

	local reqThread = task.spawn(function()
		local ok, fetched = pcall(game.HttpGet, game, url)
		if not ok or #fetched == 0 then
			success, result = false, (not ok and fetched) or "Empty response"
			done = true
			return
		end
		local execOk, execResult = pcall(function() return loadstring(fetched)() end)
		success, result = execOk, execResult
		done = true
	end)

	-- Timeout watcher — always cancels reqThread if it is still running (HARD-3)
	local timeoutThread = task.delay(timeout, function()
		if not done then
			pcallLog(task.cancel, reqThread)
			result = "Request timed out"
			done   = true
			log.warn("Rayfield | Request timed out: " .. url)
		end
	end)

	while not done do task.wait() end

	-- Cancel timeout watcher if request finished first
	if coroutine.status(timeoutThread) ~= "dead" then
		pcallLog(task.cancel, timeoutThread)
	end

	if not success then
		log.warn("Rayfield | Failed to load " .. url .. ": " .. tostring(result))
	end
	return if success then result else nil
end

