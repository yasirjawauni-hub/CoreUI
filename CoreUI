					TweenService:Create(other.Title,    TweenInfo.new(0.7, Enum.EasingStyle.Exponential), { TextColor3 = SelectedTheme.TabTextColor, TextTransparency = 0.2 }):Play()
					TweenService:Create(other.Image,    TweenInfo.new(0.7, Enum.EasingStyle.Exponential), { ImageColor3 = SelectedTheme.TabTextColor, ImageTransparency = 0.2 }):Play()
					TweenService:Create(other.UIStroke, TweenInfo.new(0.7, Enum.EasingStyle.Exponential), { Transparency = 0.5 }):Play()
