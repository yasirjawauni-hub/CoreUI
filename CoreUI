			TabButton.BackgroundColor3  = SelectedTheme.TabBackgroundSelected
			TabButton.Image.ImageColor3 = SelectedTheme.SelectedTabTextColor
			TabButton.Title.TextColor3  = SelectedTheme.SelectedTabTextColor
