local _settingsTable: { [string]: { [string]: { Type: string, Value: any, Name: string, Element: any? } } } = {
	General = {
		rayfieldOpen = { Type = "bind",   Value = "K",   Name = "Rayfield Keybind"    },
	},
	System = {
		usageAnalytics = { Type = "toggle", Value = true, Name = "Anonymised Analytics" },
	},
}
local _overrides:   { [string]: any } = {}
local _settingsCreated     = false
local _settingsInitialized = false

local function overrideSetting(category: string, name: string, value: any)
	if not (_settingsTable[category] and _settingsTable[category][name]) then
		log.warn("Rayfield | overrideSetting: unknown key '" .. category .. "." .. name .. "'")
		return
	end
	_overrides[category .. "." .. name] = value
end

local function getSetting(category: string, name: string): any
	local key = category .. "." .. name
	if _overrides[key] ~= nil then return _overrides[key] end
	local cat = _settingsTable[category]
	return cat and cat[name] and cat[name].Value
end

local function updateSetting(category: string, name: string, value: any)
	if not _settingsInitialized then return end
	_settingsTable[category][name].Value = value
	_overrides[category .. "." .. name]  = nil
end

