-- ─── Icon helpers ─────────────────────────────────────────────────────────────
local function getIcon(name: string)
	if not Icons then
		log.warn("Lucide Icons: library not loaded")
		return
	end
	name = name:lower():match("^%s*(.-)%s*$")
	local r = Icons["48px"][name]
	if not r then error('Lucide Icons: no icon "' .. name .. '"', 2) end
	return {
		id              = r[1],
		imageRectSize   = Vector2.new(r[2][1], r[2][2]),
		imageRectOffset = Vector2.new(r[3][1], r[3][2]),
	}
end

local function isCustomAsset(v)
	return type(v) == "string"
		and (v:find("rbxasset://", 1, true) == 1 or v:find("rbxthumb://", 1, true) == 1)
end

local function resolveIcon(icon)
	if not icon or icon == 0 then return "", nil, nil end
	if isCustomAsset(icon) then return icon, nil, nil end
	if secureMode then
		secureNotify("icon_blocked", "Secure Mode",
			"Element icons using asset IDs or Lucide names are blocked in Secure Mode.")
		return "", nil, nil
	end
	if type(icon) == "string" and Icons then
		local asset = getIcon(icon)
		return "rbxassetid://" .. asset.id, asset.imageRectOffset, asset.imageRectSize
	end
	if type(icon) == "number" then
		return "rbxassetid://" .. icon, nil, nil
	end
	log.warn("Rayfield | resolveIcon: icon must be a number or Lucide string")
	return "", nil, nil
end

-- ─── makeDraggable — returns cleanup fn (MEM-4) ───────────────────────────────
local function makeDraggable(object, dragObject, enableTaptic, tapticOffset)
	local dragging = false
	local relative = nil
	local offset   = Vector2.zero

	local screenGui = object:FindFirstAncestorWhichIsA("ScreenGui")
	if screenGui and screenGui.IgnoreGuiInset then
		offset += getService("GuiService"):GetGuiInset()
	end

	local conns: { RBXScriptConnection } = {}

	if dragBar and enableTaptic then
		table.insert(conns, dragBar.MouseEnter:Connect(function()
			if dragging or Hidden then return end
			TweenService:Create(dragBarCosmetic,
				TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ BackgroundTransparency = 0.5, Size = UDim2.new(0, 120, 0, 4) }):Play()
		end))
		table.insert(conns, dragBar.MouseLeave:Connect(function()
			if dragging or Hidden then return end
			TweenService:Create(dragBarCosmetic,
				TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ BackgroundTransparency = 0.7, Size = UDim2.new(0, 100, 0, 4) }):Play()
		end))
	end

	table.insert(conns, dragObject.InputBegan:Connect(function(input, processed)
		if processed then return end
		local t = input.UserInputType.Name
		if t == "MouseButton1" or t == "Touch" then
			dragging = true
			relative = object.AbsolutePosition + object.AbsoluteSize * object.AnchorPoint
				- UserInputService:GetMouseLocation()
			if enableTaptic and not Hidden then
				TweenService:Create(dragBarCosmetic,
					TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
					{ Size = UDim2.new(0, 110, 0, 4), BackgroundTransparency = 0 }):Play()
			end
		end
	end))

	table.insert(conns, UserInputService.InputEnded:Connect(function(input)
		if not dragging then return end
		local t = input.UserInputType.Name
		if t == "MouseButton1" or t == "Touch" then
			dragging = false
			if enableTaptic and not Hidden then
				TweenService:Create(dragBarCosmetic,
					TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
					{ Size = UDim2.new(0, 100, 0, 4), BackgroundTransparency = 0.7 }):Play()
			end
		end
	end))

	table.insert(conns, RunService.RenderStepped:Connect(function()
		if not dragging or Hidden then return end
		local position = UserInputService:GetMouseLocation() + relative + offset
		if enableTaptic and tapticOffset then
			TweenService:Create(object,
				TweenInfo.new(0.4, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
				{ Position = UDim2.fromOffset(position.X, position.Y) }):Play()
			TweenService:Create(dragObject.Parent,
				TweenInfo.new(0.05, Enum.EasingStyle.Exponential, Enum.EasingDirection.Out),
				{ Position = UDim2.fromOffset(position.X,
					position.Y + (useMobileSizing and tapticOffset[2] or tapticOffset[1])) }):Play()
		else
			if dragBar and tapticOffset then
				dragBar.Position = UDim2.fromOffset(position.X,
					position.Y + (useMobileSizing and tapticOffset[2] or tapticOffset[1]))
			end
			object.Position = UDim2.fromOffset(position.X, position.Y)
		end
	end))

	-- Register all conns in the module-level registry too
	for _, c in conns do trackConn(c) end

	-- Return cleanup so call-sites can disconnect on Destroy (MEM-4)
	return function() disconnectAll(conns) end
end

-- ─── Configuration save / load ────────────────────────────────────────────────
local function PackColor(c)   return { R = c.R * 255, G = c.G * 255, B = c.B * 255 } end
local function UnpackColor(t) return Color3.fromRGB(t.R, t.G, t.B) end

local function SaveConfiguration()
	if not CEnabled or not globalLoaded then return end
	local data = {}
	for k, v in RayfieldLibrary.Flags do
		if v.Type == "ColorPicker" then
			if typeof(v.Color) == "Color3" then data[k] = PackColor(v.Color) end
		else
			if typeof(v.CurrentValue) == "boolean" then
				data[k] = v.CurrentValue
			else
				data[k] = v.CurrentValue or v.CurrentKeybind or v.CurrentOption or v.Color
			end
		end
	end
	if useStudio then
		if script.Parent:FindFirstChild("configuration") then
			script.Parent.configuration:Destroy()
		end
		local sg = Instance.new("ScreenGui")
		sg.Parent = script.Parent
		sg.Name   = "configuration"
		local tb  = Instance.new("TextBox")
		tb.Parent           = sg
		tb.Size             = UDim2.new(0, 800, 0, 50)
		tb.AnchorPoint      = Vector2.new(0.5, 0)
		tb.Position         = UDim2.new(0.5, 0, 0, 30)
		tb.Text             = HttpService:JSONEncode(data)
		tb.ClearTextOnFocus = false
	end
	pcallLog(writefile,
		ConfigurationFolder .. "/" .. CFileName .. ConfigurationExtension,
		HttpService:JSONEncode(data))
end

-- LoadConfiguration: hardened flag validation (HARD-1)
local function LoadConfiguration(raw: string): boolean
	local ok, data = pcall(function() return HttpService:JSONDecode(raw) end)
	if not ok then
		log.warn("Rayfield | Failed to decode configuration — delete it and reopen.")
		return false
	end
	local changed = false
	for flagName, flag in RayfieldLibrary.Flags do
		local saved = data[flagName]
		if saved == nil then
			log.warn("Rayfield | Flag '" .. flagName .. "' not found in save file.")
			log.print("This may be expected if the script added new elements.")
			continue
		end
		task.spawn(function()
			if flag.Type == "ColorPicker" then
				-- Validate Color3 table shape (HARD-1)
				if type(saved) == "table"
					and type(saved.R) == "number"
					and type(saved.G) == "number"
					and type(saved.B) == "number"
				then
					flag:Set(UnpackColor(saved))
					changed = true
				end
			elseif flag.Type == "Toggle" then
				-- Coerce to boolean (HARD-1)
				if saved ~= nil then
					flag:Set(saved == true)
					changed = true
				end
			elseif flag.Type == "Slider" then
				-- Range-clamp before Set (HARD-1)
				local v = tonumber(saved)
				if v and flag.Range then
					v = math.clamp(v, flag.Range[1], flag.Range[2])
					if flag.CurrentValue ~= v then
						flag:Set(v)
						changed = true
					end
				end
			else
				local current = flag.CurrentValue or flag.CurrentKeybind or flag.CurrentOption or flag.Color
				if current ~= saved then
					flag:Set(saved)
					changed = true
				end
			end
		end)
	end
	return changed
end

