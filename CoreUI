local function setElementsVisible(show)
	for _, tab in Elements:GetChildren() do
		if tab.Name == "Template" or tab.ClassName ~= "ScrollingFrame" or tab.Name == "Placeholder" then
			continue
		end
		for _, elem in tab:GetChildren() do
			if elem.ClassName ~= "Frame" or elem.Name == "Placeholder" or elem.Name == "SectionSpacing" then
				continue
			end
			if elem.Name == "SectionTitle" or elem.Name == "SearchTitle-fsefsefesfsefesfesfThanks" then
				TweenService:Create(elem.Title, TweenInfo.new(0.3, Enum.EasingStyle.Exponential),
					{ TextTransparency = show and 0.4 or 1 }):Play()
			elseif elem.Name == "Divider" then
				TweenService:Create(elem.Divider, TweenInfo.new(0.3, Enum.EasingStyle.Exponential),
					{ BackgroundTransparency = show and 0.85 or 1 }):Play()
			else
				local bgT  = elem:GetAttribute("BackgroundTransparencyTarget") or 0
				local stT  = elem:GetAttribute("UIStrokeTransparencyTarget")   or 0
				local ttT  = elem:GetAttribute("TitleTextTransparencyTarget")  or 0
				TweenService:Create(elem,          TweenInfo.new(0.3, Enum.EasingStyle.Exponential), { BackgroundTransparency = show and bgT or 1 }):Play()
				TweenService:Create(elem.UIStroke, TweenInfo.new(0.3, Enum.EasingStyle.Exponential), { Transparency           = show and stT or 1 }):Play()
				TweenService:Create(elem.Title,    TweenInfo.new(0.3, Enum.EasingStyle.Exponential), { TextTransparency       = show and ttT or 1 }):Play()
			end
			for _, child in elem:GetChildren() do
				local cn = child.ClassName
				if cn == "Frame" or cn == "TextLabel" or cn == "TextBox"
					or cn == "ImageButton" or cn == "ImageLabel"
				then
					child.Visible = show
				end
			end
		end
	end
end

