-- ─── Settings tab builder ─────────────────────────────────────────────────────
local function createSettings(window)
	if not (writefile and isfile and readfile and isfolder and makefolder) and not useStudio then
		if Topbar:FindFirstChild("Settings") then Topbar.Settings.Visible = false end
		Topbar.Search.Position = UDim2.new(1, -75, 0.5, 0)
		log.warn("Rayfield | No filesystem — settings tab disabled.")
		return
	end

	local newTab = window:CreateTab("Rayfield Settings", 0, true)
	if TabList["Rayfield Settings"] then TabList["Rayfield Settings"].LayoutOrder = 1000 end
	if Elements["Rayfield Settings"] then Elements["Rayfield Settings"].LayoutOrder = 1000 end

	for catName, cat in _settingsTable do
		newTab:CreateSection(catName)
		for settingName, setting in cat do
			local cb = function(val)
				updateSetting(catName, settingName, val)
				saveSettings()
			end
			if setting.Type == "input" then
				setting.Element = newTab:CreateInput({
					Name = setting.Name, CurrentValue = setting.Value,
					PlaceholderText = setting.Placeholder, Ext = true,
					RemoveTextAfterFocusLost = setting.ClearOnFocus, Callback = cb,
				})
			elseif setting.Type == "toggle" then
				setting.Element = newTab:CreateToggle({
					Name = setting.Name, CurrentValue = setting.Value, Ext = true, Callback = cb,
				})
			elseif setting.Type == "bind" then
				setting.Element = newTab:CreateKeybind({
					Name = setting.Name, CurrentKeybind = setting.Value,
					HoldToInteract = false, Ext = true, CallOnChange = true, Callback = cb,
				})
			end
		end
	end

	_settingsCreated = true
	loadSettings()
	saveSettings()
end

