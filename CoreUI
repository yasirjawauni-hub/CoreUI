			TweenService:Create(TabButton.Title,    TweenInfo.new(0.7, Enum.EasingStyle.Exponential), { TextTransparency = 0, TextColor3 = SelectedTheme.SelectedTabTextColor }):Play()
			TweenService:Create(TabButton.Image,    TweenInfo.new(0.7, Enum.EasingStyle.Exponential), { ImageTransparency = 0, ImageColor3 = SelectedTheme.SelectedTabTextColor }):Play()

			for _, other in TabList:GetChildren() do
