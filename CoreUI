-- ─── CreateWindow ─────────────────────────────────────────────────────────────
function RayfieldLibrary:CreateWindow(Settings)
	-- Loading screen
	if Rayfield:FindFirstChild("Loading") then
		if getgenv and not getgenv().rayfieldCached then
			Rayfield.Enabled = true
			Rayfield.Loading.Visible = true
			task.wait(1.4)
			Rayfield.Loading.Visible = false
		end
	end
	if getgenv then getgenv().rayfieldCached = true end

	-- ToggleUIKeybind validation (HARD-2)
	if Settings.ToggleUIKeybind then
		local keybind = Settings.ToggleUIKeybind
		if type(keybind) == "string" then
			keybind = string.upper(keybind)
			-- Validate against enum before storing
			local validKey = pcall(function() return Enum.KeyCode[keybind] end)
			if not validKey then
				error("ToggleUIKeybind '" .. keybind .. "' is not a valid KeyCode", 2)
			end
			overrideSetting("General", "rayfieldOpen", keybind)
		elseif typeof(keybind) == "EnumItem" then
			if keybind.EnumType ~= Enum.KeyCode then
				error("ToggleUIKeybind must be a KeyCode enum", 2)
			end
			overrideSetting("General", "rayfieldOpen", keybind.Name)
		else
			error("ToggleUIKeybind must be a string or KeyCode enum", 2)
		end
	end

	ensureFolder(RayfieldFolder)

	local Passthrough = false
	Topbar.Title.Text = Settings.Name

	Main.Size = UDim2.new(0, 420, 0, 100)
	Main.Visible = true
	Main.BackgroundTransparency = 1
	if Main:FindFirstChild("Notice") then Main.Notice.Visible = false end
	Main.Shadow.Image.ImageTransparency    = 1
	Main.LoadingFrame.Title.TextTransparency    = 1
	Main.LoadingFrame.Subtitle.TextTransparency = 1
	Main.LoadingFrame.Version.TextTransparency  = 1
	Main.LoadingFrame.Title.Text    = Settings.LoadingTitle    or "Rayfield"
	Main.LoadingFrame.Subtitle.Text = Settings.LoadingSubtitle or "Interface Suite"

	if Settings.LoadingTitle ~= "Rayfield Interface Suite" then
		Main.LoadingFrame.Version.Text = "Rayfield UI"
	end
	if Settings.ShowText then
		if MPrompt then MPrompt.Title.Text = "Show " .. Settings.ShowText end
	end

	if Settings.Icon and Settings.Icon ~= 0 and Topbar:FindFirstChild("Icon") then
		Topbar.Icon.Visible = true
		Topbar.Title.Position = UDim2.new(0, 47, 0.5, 0)
		local img, ro, rs = resolveIcon(Settings.Icon)
		Topbar.Icon.Image = img
		if ro then Topbar.Icon.ImageRectOffset = ro end
		if rs then Topbar.Icon.ImageRectSize   = rs end
	end

	if dragBar then
		dragBar.Visible = false
		if dragBarCosmetic then dragBarCosmetic.BackgroundTransparency = 1 end
		dragBar.Visible = true
	end

	if Settings.Theme then
		local ok, err = pcall(ChangeTheme, Settings.Theme)
		if not ok then
			pcall(ChangeTheme, "Default")
			log.warn("Rayfield | Theme error: " .. tostring(err))
		end
	end

	Topbar.Visible   = false
	Elements.Visible = false
	Main.LoadingFrame.Visible = true

	if not Settings.DisableRayfieldPrompts then
		task.spawn(function()
			while not rayfieldDestroyed do
				task.wait(math.random(180, 600))
				if rayfieldDestroyed then break end
				RayfieldLibrary:Notify({
					Title   = "Rayfield Interface",
					Content = "Enjoying this UI library? Find it at sirius.menu/discord",
					Duration = 7, Image = 4370033185,
				})
			end
		end)
	end

	pcall(function()
		if not Settings.ConfigurationSaving.FileName then
			Settings.ConfigurationSaving.FileName = tostring(game.PlaceId)
		end
		if Settings.ConfigurationSaving.Enabled == nil then
			Settings.ConfigurationSaving.Enabled = false
		end
		CFileName           = Settings.ConfigurationSaving.FileName
		ConfigurationFolder = Settings.ConfigurationSaving.FolderName or ConfigurationFolder
		CEnabled            = Settings.ConfigurationSaving.Enabled
		if CEnabled then ensureFolder(ConfigurationFolder) end
	end)

	-- Draggable setup; store cleanup handles (MEM-4)
	local cleanupTopbarDrag = makeDraggable(Main, Topbar, false, { dragOffset, dragOffsetMobile })
	table.insert(_draggableCleanups, cleanupTopbarDrag)
	if dragBar then
		dragBar.Position = useMobileSizing
			and UDim2.new(0.5, 0, 0.5, dragOffsetMobile)
			or  UDim2.new(0.5, 0, 0.5, dragOffset)
		local cleanupDragBar = makeDraggable(Main, dragInteract, true, { dragOffset, dragOffsetMobile })
		table.insert(_draggableCleanups, cleanupDragBar)
	end

	for _, btn in TabList:GetChildren() do
		if btn.ClassName == "Frame" and btn.Name ~= "Placeholder" then
			btn.BackgroundTransparency = 1
			btn.Title.TextTransparency = 1
			btn.Image.ImageTransparency = 1
			btn.UIStroke.Transparency  = 1
		end
	end

	-- Discord invite
	if Settings.Discord and Settings.Discord.Enabled and not useStudio and not secureMode then
		ensureFolder(RayfieldFolder .. "/Discord Invites")
		local invPath = RayfieldFolder .. "/Discord Invites/" .. Settings.Discord.Invite .. ConfigurationExtension
		if not pcallLog(isfile, invPath) then
			if requestFunc then
				pcall(function()
					requestFunc({
						Url = "http://127.0.0.1:6463/rpc?v=1",
						Method = "POST",
						Headers = { ["Content-Type"] = "application/json", Origin = "https://discord.com" },
						Body = HttpService:JSONEncode({
							cmd   = "INVITE_BROWSER",
							nonce = HttpService:GenerateGUID(false),
							args  = { code = Settings.Discord.Invite },
						}),
					})
				end)
			end
			if Settings.Discord.RememberJoins then
				pcallLog(writefile, invPath, "Rayfield RememberJoins")
			end
		end
	end

	-- Key system
	if Settings.KeySystem then
		if not Settings.KeySettings then
			Passthrough = true
		else
			ensureFolder(RayfieldFolder .. "/Key System")

			if type(Settings.KeySettings.Key) == "string" then
				Settings.KeySettings.Key = { Settings.KeySettings.Key }
			end
			if Settings.KeySettings.GrabKeyFromSite then
				for i, key in ipairs(Settings.KeySettings.Key) do
					local ok, fetched = pcall(function()
						return (game:HttpGet(key):gsub("[\n\r ]", ""))
					end)
					if ok then Settings.KeySettings.Key[i] = fetched
					else log.warn("Rayfield | Key fetch error: " .. tostring(fetched)) end
				end
			end
			if not Settings.KeySettings.FileName then
				Settings.KeySettings.FileName = "No file name specified"
			end

			local keyPath = RayfieldFolder .. "/Key System/" .. Settings.KeySettings.FileName .. ConfigurationExtension
			if pcallLog(isfile, keyPath) then
				local saved = pcallLog(readfile, keyPath)
				if saved then
					for _, k in ipairs(Settings.KeySettings.Key) do
						if saved:find(k, 1, true) then Passthrough = true; break end
					end
				end
			end

			if not Passthrough and secureMode then
				log.warn("Rayfield | Secure Mode: no valid saved key.")
				Rayfield.Enabled = false
				return RayfieldLibrary
			end

			if not Passthrough then
				local attempts = Settings.KeySettings.MaxAttempts or 5
				Rayfield.Enabled = false
				local KeyUI = useStudio
					and script.Parent:FindFirstChild("Key")
					or  game:GetObjects("rbxassetid://11380036235")[1]
				KeyUI.Enabled = true

				if gethui then KeyUI.Parent = gethui()
				elseif syn and syn.protect_gui then syn.protect_gui(KeyUI); KeyUI.Parent = CoreGui
				elseif not useStudio and CoreGui:FindFirstChild("RobloxGui") then KeyUI.Parent = CoreGui.RobloxGui
				elseif not useStudio then KeyUI.Parent = CoreGui
				end

				do
					local p = gethui and gethui() or (not useStudio and CoreGui) or nil
					if p then
						for _, iface in p:GetChildren() do
							if iface.Name == KeyUI.Name and iface ~= KeyUI then
								iface.Enabled = false; iface.Name = "KeyUI-Old"
							end
						end
					end
				end

				local KM = KeyUI.Main
				KM.Title.Text       = Settings.KeySettings.Title    or Settings.Name
				KM.Subtitle.Text    = Settings.KeySettings.Subtitle or "Key System"
				KM.NoteMessage.Text = Settings.KeySettings.Note     or "No instructions"

				KM.Size = UDim2.new(0, 467, 0, 175)
				KM.BackgroundTransparency = 1; KM.Shadow.Image.ImageTransparency = 1
				KM.Title.TextTransparency = 1; KM.Subtitle.TextTransparency = 1
				KM.KeyNote.TextTransparency = 1; KM.Input.BackgroundTransparency = 1
				KM.Input.UIStroke.Transparency = 1; KM.Input.InputBox.TextTransparency = 1
				KM.NoteTitle.TextTransparency = 1; KM.NoteMessage.TextTransparency = 1
				KM.Hide.ImageTransparency = 1

				TweenService:Create(KM,              TweenInfo.new(0.6, Enum.EasingStyle.Exponential), { BackgroundTransparency = 0, Size = UDim2.new(0, 500, 0, 187) }):Play()
				TweenService:Create(KM.Shadow.Image, TweenInfo.new(0.5, Enum.EasingStyle.Exponential), { ImageTransparency = 0.5 }):Play()
				task.wait(0.05)
				TweenService:Create(KM.Title,        TweenInfo.new(0.4, Enum.EasingStyle.Exponential), { TextTransparency = 0 }):Play()
				TweenService:Create(KM.Subtitle,     TweenInfo.new(0.5, Enum.EasingStyle.Exponential), { TextTransparency = 0 }):Play()
				task.wait(0.05)
				TweenService:Create(KM.KeyNote,      TweenInfo.new(0.5, Enum.EasingStyle.Exponential), { TextTransparency = 0 }):Play()
				TweenService:Create(KM.Input,        TweenInfo.new(0.5, Enum.EasingStyle.Exponential), { BackgroundTransparency = 0 }):Play()
				TweenService:Create(KM.Input.UIStroke, TweenInfo.new(0.5, Enum.EasingStyle.Exponential), { Transparency = 0 }):Play()
				TweenService:Create(KM.Input.InputBox, TweenInfo.new(0.5, Enum.EasingStyle.Exponential), { TextTransparency = 0 }):Play()
				task.wait(0.05)
				TweenService:Create(KM.NoteTitle,    TweenInfo.new(0.4, Enum.EasingStyle.Exponential), { TextTransparency = 0 }):Play()
				TweenService:Create(KM.NoteMessage,  TweenInfo.new(0.4, Enum.EasingStyle.Exponential), { TextTransparency = 0 }):Play()
				task.wait(0.15)
				TweenService:Create(KM.Hide,         TweenInfo.new(0.4, Enum.EasingStyle.Exponential), { ImageTransparency = 0.3 }):Play()

				KM.Input.InputBox.FocusLost:Connect(function()
					local text = KM.Input.InputBox.Text
					if #text == 0 then return end
					local found, foundKey = false, ""
					for _, k in ipairs(Settings.KeySettings.Key) do
						if text == k then found = true; foundKey = k; break end
					end
					if found then
						fadeOutKeyUI(KM)
						task.wait(0.51)
						Passthrough = true
						KM.Visible = false
						if Settings.KeySettings.SaveKey then
							pcallLog(writefile, keyPath, foundKey)
							RayfieldLibrary:Notify({ Title = "Key System",
								Content = "Key saved successfully.", Image = 3605522284 })
						end
					else
						if attempts == 0 then
							fadeOutKeyUI(KM)
							task.wait(0.45)
							Players.LocalPlayer:Kick("No Attempts Remaining")
							return
						end
						KM.Input.InputBox.Text = ""
						attempts -= 1
						TweenService:Create(KM, TweenInfo.new(0.6, Enum.EasingStyle.Exponential), { Size = UDim2.new(0, 467, 0, 175) }):Play()
						TweenService:Create(KM, TweenInfo.new(0.4, Enum.EasingStyle.Elastic),     { Position = UDim2.new(0.495, 0, 0.5, 0) }):Play()
						task.wait(0.1)
						TweenService:Create(KM, TweenInfo.new(0.4, Enum.EasingStyle.Elastic),     { Position = UDim2.new(0.505, 0, 0.5, 0) }):Play()
						task.wait(0.1)
						TweenService:Create(KM, TweenInfo.new(0.4, Enum.EasingStyle.Exponential), { Position = UDim2.new(0.5, 0, 0.5, 0) }):Play()
						TweenService:Create(KM, TweenInfo.new(0.6, Enum.EasingStyle.Exponential), { Size = UDim2.new(0, 500, 0, 187) }):Play()
					end
				end)

				KM.Hide.MouseButton1Click:Connect(function()
					fadeOutKeyUI(KM)
					task.wait(0.51)
					Passthrough = true
					RayfieldLibrary:Destroy()
					KeyUI:Destroy()
				end)
			end
		end
	end

	if Settings.KeySystem then
		repeat task.wait() until Passthrough
		if rayfieldDestroyed then return end
	end

	Notifications.Template.Visible = false
	Notifications.Visible = true
	Rayfield.Enabled = true

	-- Animate in
	task.wait(0.5)
	TweenService:Create(Main,              TweenInfo.new(0.7, Enum.EasingStyle.Exponential), { BackgroundTransparency = 0 }):Play()
	TweenService:Create(Main.Shadow.Image, TweenInfo.new(0.7, Enum.EasingStyle.Exponential), { ImageTransparency = 0.6 }):Play()
	task.wait(0.1)
	TweenService:Create(Main.LoadingFrame.Title,    TweenInfo.new(0.7, Enum.EasingStyle.Exponential), { TextTransparency = 0 }):Play()
	task.wait(0.05)
	TweenService:Create(Main.LoadingFrame.Subtitle, TweenInfo.new(0.7, Enum.EasingStyle.Exponential), { TextTransparency = 0 }):Play()
	task.wait(0.05)
	TweenService:Create(Main.LoadingFrame.Version,  TweenInfo.new(0.7, Enum.EasingStyle.Exponential), { TextTransparency = 0 }):Play()

	Elements.Template.LayoutOrder = 100000
	Elements.Template.Visible     = false
	Elements.UIPageLayout.FillDirection           = Enum.FillDirection.Horizontal
	Elements.UIPageLayout.ScrollWheelInputEnabled = false
	Elements.UIPageLayout.GamepadInputEnabled     = false
	Elements.UIPageLayout.TouchInputEnabled       = false
	TabList.Template.Visible = false

	local FirstTab = false
	local Window   = {}

	-- ── Tab constructor ──────────────────────────────────────────────────────
	function Window:CreateTab(Name, Image, Ext)
		local SDone = false

		local TabButton = TabList.Template:Clone()
		TabButton.Name              = Name
		TabButton.Title.Text        = Name
		TabButton.Parent            = TabList
		TabButton.Title.TextWrapped = false
		TabButton.Size = UDim2.new(0, TabButton.Title.TextBounds.X + 30, 0, 30)

		if Image and Image ~= 0 then
			local img, ro, rs = resolveIcon(Image)
			TabButton.Image.Image = img
			if ro then TabButton.Image.ImageRectOffset = ro end
			if rs then TabButton.Image.ImageRectSize   = rs end
			TabButton.Title.AnchorPoint    = Vector2.new(0, 0.5)
