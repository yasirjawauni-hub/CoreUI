			script.Parent["get.val"].Value = encoded
		end
		pcallLog(writefile, RayfieldFolder .. "/settings" .. ConfigurationExtension, encoded)
	end
end

local function loadSettings()
	local file = nil
	local ok, err = pcall(function()
		if pcallLog(isfolder, RayfieldFolder) then
			if pcallLog(isfile, RayfieldFolder .. "/settings" .. ConfigurationExtension) then
				file = pcallLog(readfile, RayfieldFolder .. "/settings" .. ConfigurationExtension)
			end
		end
		if useStudio then
			file = [[{"General":{"rayfieldOpen":{"Value":"K","Type":"bind","Name":"Rayfield Keybind","Element":{"HoldToInteract":false,"Ext":true,"Name":"Rayfield Keybind","Set":null,"CallOnChange":true,"Callback":null,"CurrentKeybind":"K"}}},"System":{"usageAnalytics":{"Value":false,"Type":"toggle","Name":"Anonymised Analytics","Element":{"Ext":true,"Name":"Anonymised Analytics","Set":null,"CurrentValue":false,"Callback":null}}}}]]
		end
		if file then
			local decOk, decoded = pcall(function() return HttpService:JSONDecode(file) end)
			file = decOk and decoded or {}
		else
			file = {}
		end
		if not _settingsCreated then return end
		if next(file) ~= nil then
			for catName, cat in _settingsTable do
				local saved = file[catName]
				if saved then
					for settingName, setting in cat do
						local entry = saved[settingName]
						if entry then
							setting.Value = entry.Value
							if setting.Element then
								setting.Element:Set(getSetting(catName, settingName))
							end
						end
					end
				end
			end
		else
			for key, value in _overrides do
				local catName, settingName = key:match("^([^%.]+)%.(.+)$")
				if catName and settingName
					and _settingsTable[catName]
					and _settingsTable[catName][settingName]
					and _settingsTable[catName][settingName].Element
				then
					_settingsTable[catName][settingName].Element:Set(value)
				end
			end
		end
		_settingsInitialized = true
	end)
	if not ok then
		if writefile then log.warn("Rayfield | Issue accessing configuration: " .. tostring(err)) end
	end
end

loadSettings()

